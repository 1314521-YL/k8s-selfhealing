# ============ 通知渠道：邮件（填入后执行 scripts/00-config-secret.sh 并重启 heal-agent 生效） ============
# QQ邮箱示例: smtp.qq.com:465, 授权码在 邮箱设置->账号->开启IMAP/SMTP服务 后生成
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=你的邮箱@qq.com
SMTP_PASS=SMTP授权码(非登录密码)
SMTP_FROM=你的邮箱@qq.com
SMTP_TO=接收告警的邮箱,多个用英文逗号分隔
# true: STARTTLS(587端口常用)  false: 端口465直接SSL
SMTP_STARTTLS=false

# ============ AI 诊断：OpenAI 兼容 API（DeepSeek/通义/Kimi/OpenAI 均可） ============
# 未填 OPENAI_API_KEY 时自动降级为内置规则模板诊断，链路不中断
# 注意: BASE_URL 需以 /v1 结尾
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=deepseek-chat
